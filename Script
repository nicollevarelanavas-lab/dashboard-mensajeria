<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Dashboard Mensajeria v2</title><script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.9.1/chart.min.js"></script><style>body{margin:0;font-family:Segoe UI,sans-serif;background:#f5f5f5}.layout{display:grid;grid-template-columns:260px 1fr;gap:20px;padding:20px}.sidebar,.card{background:#fff;border-radius:12px;box-shadow:0 2px 8px rgba(0,0,0,.08)}.sidebar{padding:15px}.sidebar h2{color:#042C53}.sidebar select{width:100%;padding:10px;margin-bottom:10px}.main{display:grid;gap:20px}.top{display:grid;grid-template-columns:2fr 1fr 1fr;gap:20px}.kpi-main{text-align:center;padding:25px}.kpi-main .v{font-size:72px;color:#C54134;font-weight:bold}.kpi{text-align:center;padding:25px}.kpi .v{font-size:40px;color:#185FA5;font-weight:bold}.grid2{display:grid;grid-template-columns:1fr 1fr;gap:20px}.chart{padding:15px;height:380px}.tablecard{padding:15px}.tablewrap{max-height:280px;overflow:auto}table{width:100%;border-collapse:collapse}th,td{padding:8px;border-bottom:1px solid #ddd;font-size:12px}th{background:#E6F1FB}@media(max-width:900px){.layout,.top,.grid2{grid-template-columns:1fr}}</style></head><body><div class="layout"><div class="sidebar"><h2>Filtros</h2><select id="mes"></select><select id="semana"></select><select id="zona"></select><select id="pilar"></select><select id="marca"></select></div><div class="main"><div class="top"><div class="card kpi-main"><div>LECTURA GENERAL</div><div id="general" class="v">0%</div></div><div class="card kpi"><div>WHATSAPP</div><div id="ws" class="v">0%</div></div><div class="card kpi"><div>VIVA ENGAGE</div><div id="ve" class="v">0%</div></div></div><div class="grid2"><div class="card chart"><canvas id="zonaChart"></canvas></div><div class="card chart"><canvas id="marcaChart"></canvas></div></div><div class="grid2"><div class="card tablecard"><h3>Lectura por Zona</h3><div class="tablewrap"><table><thead><tr><th>Zona</th><th>%</th></tr></thead><tbody id="tz"></tbody></table></div></div><div class="card tablecard"><h3>Lectura por Marca</h3><div class="tablewrap"><table><thead><tr><th>Marca</th><th>%</th></tr></thead><tbody id="tm"></tbody></table></div></div></div></div></div><script>const URL='https://opensheet.elk.sh/1RC1VLZsbR0hpH8XuQUPT78A5RZDgiqyj6euXyxWROmQ/DATOS';let datos=[],zc,mc;fetch(URL).then(r=>r.json()).then(d=>{datos=d;render()});function pct(a,b){return b?Math.round(a/b*100):0}function render(){let ews=0,lws=0,eve=0,lve=0;datos.forEach(r=>{ews+=+r.Envios_WS||0;lws+=+r.Leidos_WS||0;eve+=+r.Envios_VivaEngage||0;lve+=+r.Leidos_VivaEngage||0});document.getElementById('ws').innerText=pct(lws,ews)+'%';document.getElementById('ve').innerText=pct(lve,eve)+'%';document.getElementById('general').innerText=pct(lws+lve,ews+eve)+'%';let z={},m={};datos.forEach(r=>{let p=pct((+r.Leidos_WS||0)+(+r.Leidos_VivaEngage||0),(+r.Envios_WS||0)+(+r.Envios_VivaEngage||0));z[r.Zona]=(z[r.Zona]||[]).concat([p]);m[r.Marca]=(m[r.Marca]||[]).concat([p]);});let za=Object.entries(z).map(([k,v])=>[k,Math.round(v.reduce((a,b)=>a+b,0)/v.length)]).sort((a,b)=>b[1]-a[1]);let ma=Object.entries(m).map(([k,v])=>[k,Math.round(v.reduce((a,b)=>a+b,0)/v.length)]).sort((a,b)=>b[1]-a[1]);if(zc)zc.destroy();zc=new Chart(zonaChart,{type:'bar',data:{labels:za.map(x=>x[0]),datasets:[{data:za.map(x=>x[1]),backgroundColor:'#185FA5'}]},options:{indexAxis:'y',plugins:{legend:{display:false}},responsive:true,maintainAspectRatio:false}});if(mc)mc.destroy();mc=new Chart(marcaChart,{type:'bar',data:{labels:ma.map(x=>x[0]),datasets:[{data:ma.map(x=>x[1]),backgroundColor:'#042C53'}]},options:{indexAxis:'y',plugins:{legend:{display:false}},responsive:true,maintainAspectRatio:false}});tz.innerHTML=za.map(x=>`<tr><td>${x[0]}</td><td>${x[1]}%</td></tr>`).join('');tm.innerHTML=ma.map(x=>`<tr><td>${x[0]}</td><td>${x[1]}%</td></tr>`).join('');}</script></body></html>
