
:root{
 --primary:#083C63;
 --secondary:#0D5EA6;
 --accent:#D94A38;
 --bg:#F4F7FB;
 --card:#fff;
 --text:#233142;
 --muted:#7b8794;
 --radius:18px;
 --shadow:0 10px 30px rgba(0,0,0,.08);
}
*{margin:0;padding:0;box-sizing:border-box}
body{
 font-family:'Inter',sans-serif;
 background:var(--bg);
 color:var(--text);
}
.app{display:grid;grid-template-columns:280px 1fr;min-height:100vh}
.sidebar{
 background:linear-gradient(180deg,#083C63,#0D5EA6);
 color:#fff;padding:28px;display:flex;flex-direction:column;gap:18px
}
.logo{display:flex;align-items:center;gap:14px;margin-bottom:10px}
.logo-icon{width:52px;height:52px;border-radius:14px;background:#fff1;display:grid;place-items:center;font-size:22px}
.logo h2{font-size:22px}
.logo span{font-size:13px;opacity:.8}
.menu-title{font-size:12px;letter-spacing:2px;opacity:.7;margin-top:10px}
.filter-group{display:flex;flex-direction:column;gap:8px}
.filter-group label{font-size:13px;font-weight:600}
.filter-group select{
 border:none;border-radius:12px;padding:12px;background:#ffffff18;color:#fff;
 backdrop-filter:blur(8px)
}
.filter-group select option{color:#000}
.sidebar-footer{margin-top:auto;border-top:1px solid #ffffff25;padding-top:20px;font-size:13px}
.content{padding:28px}
.topbar{display:flex;justify-content:space-between;align-items:center;margin-bottom:24px}
.topbar h1{font-size:32px;font-weight:800}
.topbar p{color:var(--muted);margin-top:6px}
.period-card{
 background:var(--card);padding:14px 18px;border-radius:16px;
 box-shadow:var(--shadow);display:flex;align-items:center;gap:14px
}
.hero-grid{display:grid;grid-template-columns:1.3fr 1fr;gap:24px}
.hero-card,.kpi-card,.panel{
 background:var(--card);
 border-radius:var(--radius);
 box-shadow:var(--shadow);
}
.hero-card{padding:24px;min-height:360px}
.hero-header h3{font-size:22px}
.hero-header p{color:var(--muted);margin-top:6px}
.gauge-container{height:280px;position:relative;display:flex;justify-content:center;align-items:center}
.gauge-container canvas{max-width:280px}
.gauge-center{position:absolute;font-size:54px;font-weight:800;color:var(--accent)}
.kpi-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}
.kpi-card{padding:22px;display:flex;gap:18px;align-items:center}
.kpi-icon{
 width:58px;height:58px;border-radius:14px;display:grid;place-items:center;
 font-size:24px;color:#fff
}
.whatsapp .kpi-icon{background:#25D366}
.correo .kpi-icon{background:#0D5EA6}
.total .kpi-icon{background:#D94A38}
.lectura .kpi-icon{background:#6A5ACD}
.kpi-info span{font-size:13px;color:var(--muted)}
.kpi-info h2{font-size:38px;margin:5px 0}
.panel{padding:22px;margin-top:24px}
@media(max-width:1200px){
.hero-grid{grid-template-columns:1fr}
}
@media(max-width:900px){
.app{grid-template-columns:1fr}
.sidebar{position:relative}
.content{padding:16px}
}
